# Security headers for the Cloudflare Worker's static assets.
#
# This file is not served — Workers parses it and applies the rules to asset
# responses. It does NOT apply to responses generated by Worker code, so when the
# multiplayer Worker arrives its /api/* responses must set their own headers.
#
# Limits: 100 rules, 2000 characters per line.

/*
  # --- Content Security Policy -------------------------------------------------
  # Enforced, not Report-Only. Every allowance below is load-bearing; none of it is
  # boilerplate, and each one breaks something specific if removed.
  #
  #   'unsafe-inline' in script-src is unavoidable: a static export cannot emit
  #   per-request nonces, and Next inlines its flight payload as <script> tags.
  #
  #   'unsafe-eval' is the weakest thing in this policy and the one most likely to
  #   be deleted by someone tidying up. It is here because mind-ar bundles mathjs,
  #   whose expression parser builds functions at runtime. Report-Only surfaced the
  #   violation before this was enforced. Removing it breaks REG's camera filter,
  #   and it fails through the camera-error path, so the message blames the webcam
  #   and the CSP never comes up. Self-hosting the MediaPipe assets is what would
  #   let this go — see HOSTING.md §10.
  #
  #   cdn.jsdelivr.net and storage.googleapis.com are REG's face tracking, not
  #   decoration. mind-ar fetches the MediaPipe WASM runtime from jsDelivr and the
  #   face_landmarker model from Google Cloud Storage, and it hardcodes both URLs
  #   inside its shipped bundle. Same failure mode as above if either is removed.
  #   'wasm-unsafe-eval' is what lets that WASM module compile.
  #
  # static.cloudflareinsights.com / cloudflareinsights.com are Web Analytics. Note
  # that grepping this repo for "beacon" finds nothing — Cloudflare injects the
  # script at the edge for proxied zones, so these entries look unused and are not.
  # Delete them and analytics stops silently.
  #
  # blob: covers REG's excerpt images and the recorded audio in MUSIC and the loop
  # station. worker-src blob: covers workers Emscripten may spawn.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

  # --- Transport ---------------------------------------------------------------
  # No `preload` on purpose: preloading is effectively irreversible. Add it only
  # once the domain has been stable for a while.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

  # --- Everything else ---------------------------------------------------------
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # camera and microphone MUST stay (self). Setting either to () silently kills
  # REG, the loop station, and every pitch-based game.
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), browsing-topics=()

# next/og writes the link-preview card to out/opengraph-image with no file
# extension, so the edge has nothing to infer a type from and would hand crawlers
# an octet-stream. Name it explicitly.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Content-hashed by the build, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed — these are plain files in public/, so they need to be able
# to change on a deploy.
/worklets/*
  Cache-Control: public, max-age=3600

# Icons, likewise not content-hashed. A day is long enough to be worth caching and
# short enough that a redesign lands without anyone having to clear anything.
/icon.svg
  Cache-Control: public, max-age=86400
/icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/apple-icon.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
