{
  "name": "music-garage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler dev",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses": "node scripts/check-licenses.mjs --check",
    "licenses:notices": "node scripts/check-licenses.mjs --notices",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "mind-ar": "1.2.5",
    "next": "16.3.3",
    "pitchy": "^4.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.160.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  },
  "overrides": {
    "mind-ar": {
      "canvas": "npm:empty-npm-package@1.0.0"
    }
  }
}
